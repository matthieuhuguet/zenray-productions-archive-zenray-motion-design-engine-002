// 12 October 2026: Clock (radial sweep) wipe around a centre from a start angle, soft angular edge in turns. Mask block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 transition_clock(vec2 uv, float progress, vec2 center, float start, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float turn = fract((atan(p.y, p.x) - radians(start)) / 6.28318530718);
  float e = progress * (1.0 + 2.0 * soft) - soft;
  return vec4(1.0, 1.0, 1.0, 1.0 - smoothstep(e - soft, e + soft, turn));
}
