// Source: https://bottosson.github.io/posts/oklab/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float ramp_oklab_anim_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec3 ramp_oklab_anim_to_lin(vec3 c) {
  c = max(c, 0.0);
  return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, vec3(lessThanEqual(c, vec3(0.04045))));
}
vec3 ramp_oklab_anim_to_srgb(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  return mix(1.055 * pow(max(c, vec3(1e-10)), vec3(1.0 / 2.4)) - 0.055, c * 12.92, vec3(lessThanEqual(c, vec3(0.0031308))));
}
vec3 ramp_oklab_anim_lab(vec3 c) {
  float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
  float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
  float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
  l = pow(max(l, 1e-12), 1.0 / 3.0); m = pow(max(m, 1e-12), 1.0 / 3.0); s = pow(max(s, 1e-12), 1.0 / 3.0);
  return vec3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
              1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
              0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}
vec3 ramp_oklab_anim_unlab(vec3 c) {
  float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
  float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
  float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
  l = l * l * l; m = m * m * m; s = s * s * s;
  return vec3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
              -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
              -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}
// 12 October 2026: mix of two sRGB colours through OKLab, result in sRGB.
vec3 ramp_oklab_anim_okmix(vec3 a, vec3 b, float t) {
  return ramp_oklab_anim_to_srgb(ramp_oklab_anim_unlab(mix(ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(a)), ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(b)), t)));
}
vec4 ramp_oklab_anim(vec2 uv, float angle, vec3 a0, vec3 a1, vec3 b0, vec3 b1, float time, float ease) {
  float w = clamp(time, 0.0, 1.0);
  w = mix(w, w * w * (3.0 - 2.0 * w), ease);
  vec3 la = mix(ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(a0)), ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(a1)), w);
  vec3 lb = mix(ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(b0)), ramp_oklab_anim_lab(ramp_oklab_anim_to_lin(b1)), w);
  return vec4(ramp_oklab_anim_to_srgb(ramp_oklab_anim_unlab(mix(la, lb, ramp_oklab_anim_axis(uv, angle)))), 1.0);
}
