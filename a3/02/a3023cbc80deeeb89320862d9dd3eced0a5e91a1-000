import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def _quintic(f):
    return f * f * f * (f * (f * 6.0 - 15.0) + 10.0)


def _gdot(cx, cy, seed, fx, fy):
    a = 6.28318530718 * _hash2(cx, cy, seed)[0]
    return np.cos(a) * fx + np.sin(a) * fy


def _gnoise(px, py, seed):
    ix, iy = np.floor(px), np.floor(py)
    fx, fy = px - ix, py - iy
    wx, wy = _quintic(fx), _quintic(fy)
    a = _gdot(ix, iy, seed, fx, fy)
    b = _gdot(ix + 1, iy, seed, fx - 1, fy)
    c = _gdot(ix, iy + 1, seed, fx, fy - 1)
    d = _gdot(ix + 1, iy + 1, seed, fx - 1, fy - 1)
    top = a + (b - a) * wx
    bot = c + (d - c) * wx
    return top + (bot - top) * wy


def _fbm(px, py, seed, octaves, lac, gain, kind="fbm"):
    s, a, norm = 0.0, 0.5, 0.0
    for k in range(8):
        if k >= octaves:
            break
        g = _gnoise(px, py, seed + k)
        if kind == "ridged":
            r = 1.0 - np.abs(1.41421356 * g)
            g = r * r
        elif kind == "turb":
            g = np.abs(1.41421356 * g)
        s = s + a * g
        norm += a
        px, py = px * lac + 19.19, py * lac + 7.37
        a *= gain
    return s / norm


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale'] + q['offset'][0]
    py = v * q['scale'] + q['offset'][1]
    s, o, w = q['seed'], q['octaves'], q['warp']
    ax, ay = _fbm(px, py, s, o, 2.0, 0.5), _fbm(px + 5.2, py + 1.3, s, o, 2.0, 0.5)
    bx = _fbm(px + w * ax + 1.7, py + w * ay + 9.2, s, o, 2.0, 0.5)
    by = _fbm(px + w * ax + 8.3, py + w * ay + 2.8, s, o, 2.0, 0.5)
    f = np.clip(0.5 + 0.5 * 1.41421356 * _fbm(px + w * bx, py + w * by, s, o, 2.0, 0.5), 0.0, 1.0)[..., None]
    col = _v(q['c0']) + (_v(q['c1']) - _v(q['c0'])) * f
    k = (np.clip(np.hypot(ax, ay) * 1.41421356, 0.0, 1.0) * q['c2_amount'])[..., None]
    col = col + (_v(q['c2']) - col) * k
    return col * 255.0
