import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def _vnoise(px, py, seed):
    ix, iy = np.floor(px), np.floor(py)
    fx, fy = px - ix, py - iy
    wx = fx * fx * fx * (fx * (fx * 6.0 - 15.0) + 10.0)
    wy = fy * fy * fy * (fy * (fy * 6.0 - 15.0) + 10.0)
    a = _hash2(ix, iy, seed)[0]
    b = _hash2(ix + 1, iy, seed)[0]
    c = _hash2(ix, iy + 1, seed)[0]
    d = _hash2(ix + 1, iy + 1, seed)[0]
    top = a + (b - a) * wx
    bot = c + (d - c) * wx
    return top + (bot - top) * wy


def _fbm(px, py, seed, octaves):
    s, a, n = 0.0, 0.5, 0.0
    for i in range(min(int(octaves), 8)):
        s = s + a * _vnoise(px, py, seed + float(i))
        n += a
        px, py = px * 2.0 + 17.13, py * 2.0 + 9.71
        a *= 0.5
    return s / n


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale'] + q['offset'][0] + EPS
    py = v * q['scale'] + q['offset'][1] + EPS
    qx = _fbm(px, py, q['seed'], 4)
    qy = _fbm(px + 5.2, py + 1.3, q['seed'] + 7.0, 4)
    h = _fbm(px + q['warp'] * (qx - 0.5) * 4.0, py + q['warp'] * (qy - 0.5) * 4.0, q['seed'] + 13.0, 5)
    f = h * q['bands']
    f = f - np.floor(f)
    e = q['edge']
    rock = (_ss(q['rock_share'] - e, q['rock_share'], f) * (1.0 - _ss(1.0 - e, 1.0, f)))[..., None]
    t = np.clip((h - 0.25) * 2.0, 0.0, 1.0) * 3.0
    c0, c1, c2, c3 = (_v(q[k]) for k in ('c0', 'c1', 'c2', 'c3'))
    tt = t[..., None]
    pal = np.where(tt < 1.0, c0 + (c1 - c0) * tt, np.where(tt < 2.0, c1 + (c2 - c1) * (tt - 1.0), c2 + (c3 - c2) * (tt - 2.0)))
    return (_v(q['c_rock']) + (pal - _v(q['c_rock'])) * rock) * 255.0
