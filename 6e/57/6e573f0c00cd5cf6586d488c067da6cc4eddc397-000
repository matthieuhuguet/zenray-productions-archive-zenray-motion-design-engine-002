import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


F32 = np.float32


def _mod289(x):
    return x - np.floor(x * F32(1.0 / 289.0)) * F32(289.0)


def _permute(x):
    return _mod289(((x * F32(34.0)) + F32(10.0)) * x)


def _snoise2(vx, vy):
    # 12 October 2026: float32 throughout, mirroring the GPU (floors at lattice points depend on float32 rounding).
    vx, vy = np.asarray(vx, F32), np.asarray(vy, F32)
    cx, cy, cz, cw = F32(0.211324865405187), F32(0.366025403784439), F32(-0.577350269189626), F32(0.024390243902439)
    s = vx * cy + vy * cy
    ix, iy = np.floor(vx + s), np.floor(vy + s)
    t = ix * cx + iy * cx
    x0x, x0y = vx - ix + t, vy - iy + t
    i1x = (x0x > x0y).astype(F32)
    i1y = F32(1.0) - i1x
    x12x, x12y = x0x + cx - i1x, x0y + cx - i1y
    x12z, x12w = x0x + cz, x0y + cz
    ix, iy = _mod289(ix), _mod289(iy)
    one, zero = F32(1.0), F32(0.0)
    p = [_permute(_permute(iy + oy) + ix + ox) for ox, oy in ((zero, zero), (i1x, i1y), (one, one))]
    d = [x0x * x0x + x0y * x0y, x12x * x12x + x12y * x12y, x12z * x12z + x12w * x12w]
    gx = [(x0x, x0y), (x12x, x12y), (x12z, x12w)]
    out = np.zeros(vx.shape, F32)
    for k in range(3):
        m = np.maximum(F32(0.5) - d[k], F32(0.0))
        m = m * m
        m = m * m
        q = p[k] * cw
        x = F32(2.0) * (q - np.floor(q)) - F32(1.0)
        h = np.abs(x) - F32(0.5)
        a0 = x - np.floor(x + F32(0.5))
        m = m * (F32(1.79284291400159) - F32(0.85373472095314) * (a0 * a0 + h * h))
        out = out + m * (a0 * gx[k][0] + h * gx[k][1])
    return F32(130.0) * out


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale'] + q['offset'][0]
    py = v * q['scale'] + q['offset'][1]
    s = np.floor(q['seed'])
    px = (px.astype(np.float32) + np.float32(s * 37.0))
    py = (py.astype(np.float32) + np.float32(s * 17.0))
    n = 0.5 + 0.5 * _snoise2(px, py).astype(float)
    return np.clip((n - 0.5) * q['contrast'] + 0.5, 0.0, 1.0)
