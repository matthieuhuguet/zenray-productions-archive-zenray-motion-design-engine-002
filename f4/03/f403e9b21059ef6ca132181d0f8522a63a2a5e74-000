// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 transition_crossfade(vec2 uv, float progress, float ease) {
  float s = progress * progress * (3.0 - 2.0 * progress);
  return vec4(1.0, 1.0, 1.0, mix(progress, s, ease));
}
