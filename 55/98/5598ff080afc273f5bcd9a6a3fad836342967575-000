// 12 October 2026: Capsule (rounded segment) coverage between two points, exact segment distance minus a radius. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: a (uv), b (uv), radius (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_capsule_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_capsule(vec2 uv, vec2 a, vec2 b, float radius, float soft, float aspect) {
  vec2 s = vec2(aspect, 1.0);
  vec2 pa = (uv - a) * s, ba = (b - a) * s;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
  return vec4(1.0, 1.0, 1.0, sdf_capsule_cov(length(pa - ba * h) - radius, soft));
}
