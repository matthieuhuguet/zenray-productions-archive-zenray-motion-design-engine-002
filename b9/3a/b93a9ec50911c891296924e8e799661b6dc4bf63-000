// 12 October 2026: Specular band with a sharp core and exponential halo, bowed by a curvature (reflection on a curved glass). Colour block for add.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), angle (degrees (band normal)), position (uv along the normal), core (uv), falloff (uv), halo (level), bend (1 / uv), intensity (gain).
vec4 specular_band_curved(vec2 uv, vec3 color, float angle, float position, float core, float falloff, float halo, float bend, float intensity) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a)), perp = vec2(-dir.y, dir.x);
  vec2 c = uv - 0.5;
  float t = dot(c, dir) - bend * dot(c, perp) * dot(c, perp);
  float dist = abs(t - (position - 0.5));
  float g = max(1.0 - smoothstep(core, core + falloff, dist), halo * exp(-dist / falloff));
  return vec4(clamp(color * g * intensity, 0.0, 1.0), 1.0);
}
