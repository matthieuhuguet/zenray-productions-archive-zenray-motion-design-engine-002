// 12 October 2026: Two-level domain warp coloured by a three-colour palette (c2 weighted by the first warp length). Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (pcg2d hash implemented from Jarzynski and Olano, Hash Functions for GPU Rendering, JCGT 2020; algorithm, no code copied), same licence as the engine.
// Source: https://jcgt.org/published/0009/03/02/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 noise_warp_palette_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
// 12 October 2026: two uniform values in [0, 1) per integer cell, exact 24-bit conversion (identical in numpy).
vec2 noise_warp_palette_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = noise_warp_palette_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
vec2 noise_warp_palette_quintic(vec2 f) { return f * f * f * (f * (f * 6.0 - 15.0) + 10.0); }
float noise_warp_palette_gdot(vec2 cell, float seed, vec2 f) {
  float a = 6.28318530718 * noise_warp_palette_hash2(cell, seed).x;
  return cos(a) * f.x + sin(a) * f.y;
}
// 12 October 2026: gradient (Perlin style) noise with unit gradients and quintic fade, range about [-0.71, 0.71].
float noise_warp_palette_gnoise(vec2 p, float seed) {
  vec2 i = floor(p);
  vec2 f = p - i;
  vec2 w = noise_warp_palette_quintic(f);
  float a = noise_warp_palette_gdot(i, seed, f);
  float b = noise_warp_palette_gdot(i + vec2(1.0, 0.0), seed, f - vec2(1.0, 0.0));
  float c = noise_warp_palette_gdot(i + vec2(0.0, 1.0), seed, f - vec2(0.0, 1.0));
  float d = noise_warp_palette_gdot(i + vec2(1.0, 1.0), seed, f - vec2(1.0, 1.0));
  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}
// 12 October 2026: fractal sum of gradient noise; ceil(octaves) octaves (max 8), normalised by the weight sum.
float noise_warp_palette_fbm(vec2 p, float seed, float octaves, float lac, float gain) {
  float s = 0.0, a = 0.5, norm = 0.0;
  for (int k = 0; k < 8; k++) {
    if (float(k) >= octaves) break;
    s += a * noise_warp_palette_gnoise(p, seed + float(k));
    norm += a;
    p = p * lac + vec2(19.19, 7.37);
    a *= gain;
  }
  return s / norm;
}
vec4 noise_warp_palette(vec2 uv, float scale, vec2 offset, float seed, float octaves, float warp, vec3 c0, vec3 c1, vec3 c2, float c2_amount, float aspect) {
  vec2 p = vec2(uv.x * aspect, uv.y) * scale + offset;
  vec2 a = vec2(noise_warp_palette_fbm(p, seed, octaves, 2.0, 0.5), noise_warp_palette_fbm(p + vec2(5.2, 1.3), seed, octaves, 2.0, 0.5));
  vec2 b = vec2(noise_warp_palette_fbm(p + warp * a + vec2(1.7, 9.2), seed, octaves, 2.0, 0.5), noise_warp_palette_fbm(p + warp * a + vec2(8.3, 2.8), seed, octaves, 2.0, 0.5));
