# 12 October 2026 (A4): chip_blip, a chiptune blip: a pulse wave (additive, band limited, Fourier series of a pulse of
# duty d, a_k = sin(pi k d) / k) that plays up to three discrete pitches in a row (an arpeggio inside one blip), each
# held for step_s, with a short decay per note and an overall decay. Gap measured by the A3 calibration: blip stft
# error 3.0 JND, no progress between runs 2 and 4. Parameter categories: pitch (f0_hz, step1_st, step2_st, step_s),
# colour (duty, note_decay_s), level (amp_db, decay_s, onset_s). Derived from the mathematics, no code copied.
# FR : blip de console : onde pulse à trois notes discrètes dans un seul blip.
import math

import torch

from zrmd.audio import sfxdsp as D
from zrmd.audio.bank import Block, db_to_amp

H = 24
META = D.meta("ui", "Chip blip: a band-limited pulse wave playing up to three discrete pitches in a row, with per-note and overall decay.",
              ["ui", "blip", "chip", "8bit", "arpeggio", "coin", "pickup", "pulse"], "Fourier series of a pulse wave with stepped pitch")


class ChipBlip(Block):
    ID = "chip_blip"
    FIT = {"scanPairs": [["f0_hz", "step1_st"], ["step1_st", "step2_st"], ["step_s", "onset_s"]]}
    PARAMS = [
        D.param("f0_hz", "Hz", 100, 4000, 880, "log", "pitch of the first note"),
        D.param("step1_st", "semitones", -24, 24, 7, "lin", "second note relative to the first"),
        D.param("step2_st", "semitones", -24, 24, 12, "lin", "third note relative to the first"),
        D.param("step_s", "s", 0.015, 0.3, 0.06, "log", "length of each note"),
        D.param("notes", "notes", 1, 3, 2, "lin", "number of notes (continuous)"),
        D.param("duty", "fraction", 0.05, 0.5, 0.25, "lin", "pulse width"),
        D.param("note_decay_s", "s (T60)", 0.02, 2.0, 0.4, "log", "decay inside each note"),
        D.param("decay_s", "s (T60)", 0.03, 3.0, 0.5, "log", "decay of the whole blip"),
        D.AMP(-16.0), D.ONSET(0.25, 0.02),
    ]

    def synth(self, v, t, sr):
        dev = t.device
        st = D.soft_steps(t, v["onset_s"], v["step_s"], [torch.zeros_like(v["step1_st"]), v["step1_st"], v["step2_st"]], 0.0005)
        f = v["f0_hz"] * torch.pow(2.0, st / 12.0)
        ph = D.phase_from_freq(f * D.gate(t, v["onset_s"]), sr)
        k = torch.arange(1, H + 1, device=dev, dtype=torch.float32)
        a = torch.sin(math.pi * k * v["duty"]) / k
        nyq = (f[None, :] * k[:, None] < 0.45 * sr).float()
        y = (a[:, None] * nyq * torch.sin(k[:, None] * ph[None, :])).sum(0) / torch.sqrt((a * a).sum() / 2.0 + 1e-12)
        # Note envelope restarts at every step (sawtooth of time since the last step), the blip ends after `notes` notes.
        local = torch.clamp(t - v["onset_s"], min=0.0)
        since = local - v["step_s"] * torch.floor(local.detach() / v["step_s"])
        note_env = torch.pow(10.0, -3.0 * since / v["note_decay_s"])
        end = D.gate(t, v["onset_s"]) * torch.sigmoid((v["onset_s"] + v["notes"] * v["step_s"] - t) / 0.0008)
        env = D.decay(t, v["onset_s"], v["decay_s"], 0.0005) * note_env * end
        return db_to_amp(v["amp_db"]) * y * env


BLOCK = ChipBlip
