// 12 October 2026: Flat metal ring shaded as a tube: Lambert with ambient plus Blinn specular with Schlick fresnel whose F0 is the metal tint (PBR-ish). Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), thickness (uv (height units)), metal (sRGB 0..1), light_angle (degrees (azimuth)), elevation (degrees), shininess (Blinn exponent), ambient (level), soft (uv (height units)), aspect (width / height).
float metal_ring_tint_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 metal_ring_tint(vec2 uv, vec2 center, float radius, float thickness, vec3 metal, float light_angle, float elevation, float shininess, float ambient, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float l = length(p);
  vec2 dir = p / max(l, 1e-6);
  float s = clamp((l - radius) / thickness, -1.0, 1.0);
  vec3 n = vec3(dir * s, sqrt(max(1.0 - s * s, 0.0)));
  float az = radians(light_angle), el = radians(elevation);
  vec3 L = vec3(cos(az) * cos(el), sin(az) * cos(el), sin(el));
  vec3 H = normalize(L + vec3(0.0, 0.0, 1.0));
  float diff = max(dot(n, L), 0.0);
  float spec = pow(max(dot(n, H), 0.0), shininess);
  vec3 F = metal + (1.0 - metal) * pow(1.0 - max(H.z, 0.0), 5.0);
  vec3 col = metal * (ambient + (1.0 - ambient) * diff) + F * spec;
  return vec4(clamp(col, 0.0, 1.0) * metal_ring_tint_cov(abs(l - radius) - thickness, soft), 1.0);
}
