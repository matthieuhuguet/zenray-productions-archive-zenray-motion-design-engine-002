// 12 October 2026: Repeated rings (onion repeated with a period) up to an outer radius, for ripples and radar rings. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), period (uv (height units)), thickness (uv (height units)), phase (fraction of period), outer (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_concentric_rings_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_concentric_rings(vec2 uv, vec2 center, float period, float thickness, float phase, float outer, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float l = length(p);
  float x = mod(l - phase * period, period);
  float d = abs(x - 0.5 * period) - thickness;
  return vec4(1.0, 1.0, 1.0, sdf_concentric_rings_cov(d, soft) * sdf_concentric_rings_cov(l - outer, soft));
}
