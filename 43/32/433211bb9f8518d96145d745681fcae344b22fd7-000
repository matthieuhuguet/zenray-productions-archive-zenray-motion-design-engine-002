// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float transition_wipe_linear_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec4 transition_wipe_linear(vec2 uv, float progress, float angle, float soft) {
  float t = transition_wipe_linear_axis(uv, angle);
  float e = progress * (1.0 + 2.0 * soft) - soft;
  return vec4(1.0, 1.0, 1.0, 1.0 - smoothstep(e - soft, e + soft, t));
}
