// 12 October 2026: Three-stop radial gradient from a centre (sRGB mixing), clamped beyond the radius. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), c0 (sRGB 0..1), c1 (sRGB 0..1), c2 (sRGB 0..1), s1 (ramp position), aspect (width / height).
vec3 radial_gradient3_ramp3(float t, vec3 c0, vec3 c1, vec3 c2, float s1) {
  float p = clamp(s1, 1e-4, 1.0 - 1e-4);
  return t < p ? mix(c0, c1, t / p) : mix(c1, c2, (t - p) / (1.0 - p));
}
vec4 radial_gradient3(vec2 uv, vec2 center, float radius, vec3 c0, vec3 c1, vec3 c2, float s1, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float t = clamp(length(p) / radius, 0.0, 1.0);
  return vec4(radial_gradient3_ramp3(t, c0, c1, c2, s1), 1.0);
}
