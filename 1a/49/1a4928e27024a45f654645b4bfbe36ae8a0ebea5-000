import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def _to_lin(c):
    c = np.maximum(c, 0.0)
    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def _to_srgb(c):
    c = np.clip(c, 0.0, 1.0)
    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.power(np.maximum(c, 1e-10), 1.0 / 2.4) - 0.055)


def render(params, u, v):
    q = params
    hdr = _to_lin(_v(q['tint'])) * (2.0 ** (q['ev_min'] + (q['ev_max'] - q['ev_min']) * _axis(u, v, q['angle'])))[..., None]
    e = q['exposure']
    c = hdr * e
    TO2020 = np.array([[0.6274, 0.0691, 0.0164], [0.3293, 0.9195, 0.0880], [0.0433, 0.0113, 0.8956]]).T
    FROM2020 = np.array([[1.6605, -0.1246, -0.0182], [-0.5876, 1.1329, -0.1006], [-0.0728, -0.0083, 1.1187]]).T
    INSET = np.array([[0.856627153315983, 0.137318972929847, 0.11189821299995], [0.0951212405381588, 0.761241990602591, 0.0767994186031903],
                      [0.0482516061458583, 0.101439036467562, 0.811302368396859]]).T
    OUTSET = np.array([[1.1271005818144368, -0.1413297634984383, -0.14132976349843826], [-0.11060664309660323, 1.157823702216272, -0.11060664309660294],
                       [-0.016493938717834573, -0.016493938717834257, 1.2519364065950405]]).T
    lo, hi = -12.47393, 4.026069
    c = c @ TO2020.T
    c = c @ INSET.T
    c = np.log2(np.maximum(c, 1e-10))
    c = np.clip((c - lo) / (hi - lo), 0.0, 1.0)
    x2 = c * c
    x4 = x2 * x2
    c = 15.5 * x4 * x2 - 40.14 * x4 * c + 31.96 * x4 - 6.868 * x2 * c + 0.4298 * x2 + 0.1191 * c - 0.00232
    c = c @ OUTSET.T
    c = np.power(np.maximum(c, 0.0), 2.2)
    c = np.clip(c @ FROM2020.T, 0.0, 1.0)
    return _to_srgb(c) * 255.0
