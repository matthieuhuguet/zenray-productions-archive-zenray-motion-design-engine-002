// Params: center (uv), radius (uv (height units)), sides (count (floored)), rotation (degrees), soft (uv (height units)), aspect (width / height).
float sdf_ngon_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_ngon(vec2 uv, vec2 center, float radius, float sides, float rotation, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float n = floor(sides);
  float a = atan(p.y, p.x) - radians(rotation);
  float r = 6.28318530718 / n;
  float d = cos(floor(0.5 + a / r) * r - a) * length(p) - radius * cos(3.14159265359 / n);
  return vec4(1.0, 1.0, 1.0, sdf_ngon_cov(d, soft));
}
