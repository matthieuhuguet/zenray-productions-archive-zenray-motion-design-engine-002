  float d = thin_film_iridescence_box(pp, half_size, radius);
  float cov = 1.0 - smoothstep(-soft, soft, d);
  float w = exp(-(d / edge_width) * (d / edge_width));
  vec3 spec = 0.5 + 0.5 * cos(6.2831853 * (cycles * (-d / edge_width) + phase + vec3(0.0, 0.333, 0.667)));
  vec3 col = mix(c_body, spec, strength * w);
  return vec4(col * cov, 1.0);
}
