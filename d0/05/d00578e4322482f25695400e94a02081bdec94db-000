// 12 October 2026: Iris (circle) transition from a centre, radius reaching the farthest corner at progress 1. Mask block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 transition_iris(vec2 uv, float progress, vec2 center, float soft, float aspect) {
  vec2 sc = vec2(aspect, 1.0);
  vec2 p = (uv - center) * sc;
  vec2 far = max(center, 1.0 - center) * sc;
  float rmax = length(far);
  float R = progress * (rmax + 2.0 * soft) - soft;
  return vec4(1.0, 1.0, 1.0, 1.0 - smoothstep(R - soft, R + soft, length(p)));
}
