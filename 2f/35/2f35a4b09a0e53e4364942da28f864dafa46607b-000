// 12 October 2026: Superellipse (squircle) coverage |x/a|^n + |y/b|^n = 1, distance approximated by the scaled norm. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), half_size (uv (height units)), exponent (n), soft (uv (height units)), aspect (width / height).
float sdf_superellipse_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_superellipse(vec2 uv, vec2 center, vec2 half_size, float exponent, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  vec2 r = abs(p) / half_size;
  float s = pow(max(pow(r.x, exponent) + pow(r.y, exponent), 1e-20), 1.0 / exponent);
  return vec4(1.0, 1.0, 1.0, sdf_superellipse_cov((s - 1.0) * min(half_size.x, half_size.y), soft));
}
