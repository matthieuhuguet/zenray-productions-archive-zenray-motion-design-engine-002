// Source: https://jcgt.org/published/0009/03/02/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 transition_dissolve_noise_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
// 12 October 2026: two uniform values in [0, 1) per integer cell, exact 24-bit conversion (identical in numpy).
vec2 transition_dissolve_noise_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = transition_dissolve_noise_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
vec2 transition_dissolve_noise_quintic(vec2 f) { return f * f * f * (f * (f * 6.0 - 15.0) + 10.0); }
float transition_dissolve_noise_gdot(vec2 cell, float seed, vec2 f) {
  float a = 6.28318530718 * transition_dissolve_noise_hash2(cell, seed).x;
  return cos(a) * f.x + sin(a) * f.y;
}
// 12 October 2026: gradient (Perlin style) noise with unit gradients and quintic fade, range about [-0.71, 0.71].
float transition_dissolve_noise_gnoise(vec2 p, float seed) {
  vec2 i = floor(p);
  vec2 f = p - i;
  vec2 w = transition_dissolve_noise_quintic(f);
  float a = transition_dissolve_noise_gdot(i, seed, f);
  float b = transition_dissolve_noise_gdot(i + vec2(1.0, 0.0), seed, f - vec2(1.0, 0.0));
  float c = transition_dissolve_noise_gdot(i + vec2(0.0, 1.0), seed, f - vec2(0.0, 1.0));
  float d = transition_dissolve_noise_gdot(i + vec2(1.0, 1.0), seed, f - vec2(1.0, 1.0));
  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}
// 12 October 2026: fractal sum of gradient noise; ceil(octaves) octaves (max 8), normalised by the weight sum.
float transition_dissolve_noise_fbm(vec2 p, float seed, float octaves, float lac, float gain) {
  float s = 0.0, a = 0.5, norm = 0.0;
  for (int k = 0; k < 8; k++) {
    if (float(k) >= octaves) break;
    s += a * transition_dissolve_noise_gnoise(p, seed + float(k));
    norm += a;
    p = p * lac + vec2(19.19, 7.37);
    a *= gain;
  }
  return s / norm;
}
vec4 transition_dissolve_noise(vec2 uv, float progress, float scale, float seed, float soft, float octaves, float aspect) {
  vec2 p = vec2(uv.x * aspect, uv.y) * scale;
  float n = clamp(0.5 + 0.5 * 1.41421356 * transition_dissolve_noise_fbm(p, seed, octaves, 2.0, 0.5), 0.0, 1.0);
  float e = progress * (1.0 + 2.0 * soft) - soft;
  return vec4(1.0, 1.0, 1.0, smoothstep(n - soft, n + soft, e));
}
