import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def _to_lin(c):
    c = np.maximum(c, 0.0)
    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def _to_srgb(c):
    c = np.clip(c, 0.0, 1.0)
    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.power(np.maximum(c, 1e-10), 1.0 / 2.4) - 0.055)


def render(params, u, v):
    q = params
    hdr = _to_lin(_v(q['tint'])) * (2.0 ** (q['ev_min'] + (q['ev_max'] - q['ev_min']) * _axis(u, v, q['angle'])))[..., None]
    e = q['exposure']
    c = hdr * (e / 0.6)
    MI = np.array([[0.59719, 0.07600, 0.02840], [0.35458, 0.90834, 0.13383], [0.04823, 0.01566, 0.83777]]).T
    MO = np.array([[1.60475, -0.10208, -0.00327], [-0.53108, 1.10813, -0.07276], [-0.07367, -0.00605, 1.07602]]).T
    c = c @ MI.T
    a = c * (c + 0.0245786) - 0.000090537
    b = c * (0.983729 * c + 0.4329510) + 0.238081
    c = np.clip((a / b) @ MO.T, 0.0, 1.0)
    return _to_srgb(c) * 255.0
