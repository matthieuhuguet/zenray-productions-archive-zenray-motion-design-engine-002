import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


F32 = np.float32


def _mod289(x):
    return x - np.floor(x * F32(1.0 / 289.0)) * F32(289.0)


def _permute(x):
    return _mod289(((x * F32(34.0)) + F32(10.0)) * x)


def _snoise3(vx, vy, vz):
    # 12 October 2026: float32 throughout, mirroring the GPU (floors at lattice points depend on float32 rounding).
    v = [np.asarray(a, F32) for a in (vx, vy, vz)]
    cx, cy = F32(1.0 / 6.0), F32(1.0 / 3.0)
    one, zero, half = F32(1.0), F32(0.0), F32(0.5)
    s = v[0] * cy + v[1] * cy + v[2] * cy
    i = [np.floor(a + s) for a in v]
    t = i[0] * cx + i[1] * cx + i[2] * cx
    x0 = [v[k] - i[k] + t for k in range(3)]
    g = [(x0[0] >= x0[1]).astype(F32), (x0[1] >= x0[2]).astype(F32), (x0[2] >= x0[0]).astype(F32)]
    l = [one - a for a in g]
    lzxy = [l[2], l[0], l[1]]
    i1 = [np.minimum(g[k], lzxy[k]) for k in range(3)]
    i2 = [np.maximum(g[k], lzxy[k]) for k in range(3)]
    x1 = [x0[k] - i1[k] + cx for k in range(3)]
    x2 = [x0[k] - i2[k] + cy for k in range(3)]
    x3 = [x0[k] - half for k in range(3)]
    i = [_mod289(a) for a in i]
    offs = [(zero, zero, zero), (i1[0], i1[1], i1[2]), (i2[0], i2[1], i2[2]), (one, one, one)]
    p = [_permute(_permute(_permute(i[2] + o[2]) + i[1] + o[1]) + i[0] + o[0]) for o in offs]
    n_ = F32(0.142857142857)
    nsx, nsy, nsz = n_ * F32(2.0), n_ * half - one, n_ * one
    corners = [x0, x1, x2, x3]
    out = np.zeros(v[0].shape, F32)
    for k in range(4):
        j = p[k] - F32(49.0) * np.floor(p[k] * nsz * nsz)
        xq = np.floor(j * nsz)
        yq = np.floor(j - F32(7.0) * xq)
        x = xq * nsx + nsy
        y = yq * nsx + nsy
        h = one - np.abs(x) - np.abs(y)
        sx = np.floor(x) * F32(2.0) + one
        sy = np.floor(y) * F32(2.0) + one
        sh = -(h <= zero).astype(F32)
        gx = x + sx * sh
        gy = y + sy * sh
        nrm = F32(1.79284291400159) - F32(0.85373472095314) * (gx * gx + gy * gy + h * h)
        gx, gy, gz = gx * nrm, gy * nrm, h * nrm
        c = corners[k]
        m = np.maximum(F32(0.5) - (c[0] * c[0] + c[1] * c[1] + c[2] * c[2]), zero)
        m = m * m
        out = out + m * m * (gx * c[0] + gy * c[1] + gz * c[2])
    return F32(105.0) * out


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale'] + q['offset'][0]
    py = v * q['scale'] + q['offset'][1]
    pz = np.full(px.shape, np.float32(q['time']) * np.float32(q['speed']) + np.float32(np.floor(q['seed']) * 13.0), np.float32)
    n = 0.5 + 0.5 * _snoise3(px, py, pz).astype(float)
    return np.clip((n - 0.5) * q['contrast'] + 0.5, 0.0, 1.0)
