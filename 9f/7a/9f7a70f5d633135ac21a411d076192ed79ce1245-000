// 12 October 2026: Two discs merged by a polynomial smooth minimum (metaball-like blend radius k). Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center_a (uv), radius_a (uv (height units)), center_b (uv), radius_b (uv (height units)), k (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_smooth_union_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
float sdf_smooth_union_smin(float a, float b, float k) {
  float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
  return mix(b, a, h) - k * h * (1.0 - h);
}
vec4 sdf_smooth_union(vec2 uv, vec2 center_a, float radius_a, vec2 center_b, float radius_b, float k, float soft, float aspect) {
  vec2 s = vec2(aspect, 1.0);
  float da = length((uv - center_a) * s) - radius_a;
  float db = length((uv - center_b) * s) - radius_b;
  return vec4(1.0, 1.0, 1.0, sdf_smooth_union_cov(sdf_smooth_union_smin(da, db, k), soft));
}
