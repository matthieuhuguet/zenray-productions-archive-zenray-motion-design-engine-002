// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float transition_blinds_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec4 transition_blinds(vec2 uv, float progress, float count, float angle, float soft, float stagger) {
  float t = transition_blinds_axis(uv, angle) * count;
  float stripe = floor(t);
  float local = t - stripe;
  float pl = clamp(progress * (1.0 + stagger) - stagger * stripe / count, 0.0, 1.0);
  float e = pl * (1.0 + 2.0 * soft) - soft;
  return vec4(1.0, 1.0, 1.0, 1.0 - smoothstep(e - soft, e + soft, local));
}
