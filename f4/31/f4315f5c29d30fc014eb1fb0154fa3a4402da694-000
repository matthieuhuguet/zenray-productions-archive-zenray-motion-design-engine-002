// 12 October 2026: Arch (doorway) coverage: a box with a semicircular top, union of an exact box and an exact circle distance; base is the bottom middle point. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: base (uv), half_width (uv (height units)), height (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_arch_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
float sdf_arch_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 sdf_arch(vec2 uv, vec2 base, float half_width, float height, float soft, float aspect) {
  vec2 p = (uv - base) * vec2(aspect, 1.0);
  float hr = max(height - half_width, 0.0);
  float db = sdf_arch_box(p - vec2(0.0, -0.5 * hr), vec2(half_width, 0.5 * hr + 1e-5), 0.0);
  float dc = length(p - vec2(0.0, -hr)) - half_width;
  return vec4(1.0, 1.0, 1.0, sdf_arch_cov(min(db, dc), soft));
}
