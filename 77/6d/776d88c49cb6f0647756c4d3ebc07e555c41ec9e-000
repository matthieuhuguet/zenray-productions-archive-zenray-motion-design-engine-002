// 12 October 2026: Rounded rectangle vignette as a multiplier, following the frame shape: smoothstep(-falloff, falloff, box distance). Colour block for multiply.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: half_size (uv (height units)), radius (uv (height units)), falloff (uv (height units)), amount (strength), tint (sRGB 0..1), aspect (width / height).
float vignette_rounded_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 vignette_rounded_rect(vec2 uv, vec2 half_size, float radius, float falloff, float amount, vec3 tint, float aspect) {
  vec2 p = (uv - 0.5) * vec2(aspect, 1.0);
  float d = vignette_rounded_rect_box(p, half_size * vec2(aspect, 1.0), radius);
  float f = amount * smoothstep(-falloff, falloff, d);
  return vec4(mix(vec3(1.0), tint, f), 1.0);
}
