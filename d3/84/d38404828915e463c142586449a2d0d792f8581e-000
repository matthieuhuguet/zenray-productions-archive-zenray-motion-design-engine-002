import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def _worley(px, py, seed, jitter):
    ix, iy = np.floor(px), np.floor(py)
    fx, fy = px - ix, py - iy
    ds, cx, cy = [], [], []
    for y in (-1, 0, 1):
        for x in (-1, 0, 1):
            hx, hy = _hash2(ix + x, iy + y, seed)
            ox = x + 0.5 + jitter * (hx - 0.5)
            oy = y + 0.5 + jitter * (hy - 0.5)
            ds.append(np.hypot(ox - fx, oy - fy))
            cx.append(ix + x)
            cy.append(iy + y)
    ds, cx, cy = np.stack(ds), np.stack(cx), np.stack(cy)
    k = np.argmin(ds, axis=0)
    d1 = np.take_along_axis(ds, k[None], 0)[0]
    d2 = np.partition(ds, 1, axis=0)[1]
    return d1, d2, np.take_along_axis(cx, k[None], 0)[0], np.take_along_axis(cy, k[None], 0)[0]


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale'] + q['offset'][0]
    py = v * q['scale'] + q['offset'][1]
    d1, d2, _, _ = _worley(px, py, q['seed'], q['jitter'])
    n = d1 + (d2 - d1 - d1) * q['mode']
    n = n + (1.0 - n - n) * q['invert']
    return np.clip((n - 0.5) * q['contrast'] + 0.5, 0.0, 1.0)
