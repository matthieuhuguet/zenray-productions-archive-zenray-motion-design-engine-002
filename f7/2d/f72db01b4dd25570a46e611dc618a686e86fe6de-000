import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    asp = q['aspect']
    cx, cy = q['center']
    rmax = np.hypot(max(cx, 1.0 - cx) * asp, max(cy, 1.0 - cy))
    R = q['progress'] * (rmax + 2.0 * q['soft']) - q['soft']
    r = np.hypot((u - cx) * asp, v - cy)
    return 1.0 - _ss(R - q['soft'], R + q['soft'], r)
