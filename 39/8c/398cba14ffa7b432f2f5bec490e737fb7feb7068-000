import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def _box(px, py, b, r):
    r = min(r, min(b[0], b[1]))
    qx = np.abs(px) - b[0] + r
    qy = np.abs(py) - b[1] + r
    return np.hypot(np.maximum(qx, 0.0), np.maximum(qy, 0.0)) + np.minimum(np.maximum(qx, qy), 0.0) - r


def render(params, u, v):
    q = params
    px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    d = _box(px, py, q['half_size'], q['radius'])
    cov = (1.0 - _ss(-q['soft'], q['soft'], d))[..., None]
    w = np.exp(-(d / q['edge_width']) ** 2)[..., None]
    ph = (q['cycles'] * (-d / q['edge_width']) + q['phase'])[..., None] + np.array([0.0, 0.333, 0.667])
    spec = 0.5 + 0.5 * np.cos(6.2831853 * ph)
    col = _v(q['c_body']) + (spec - _v(q['c_body'])) * (q['strength'] * w)
    return col * cov * 255.0
