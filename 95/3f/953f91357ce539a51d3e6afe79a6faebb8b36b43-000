// 12 October 2026: Outline of a rounded rectangle (onion operator: absolute distance minus half thickness), for borders and bezels. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), half_size (uv (height units)), radius (uv (height units)), thickness (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_onion_rect_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
float sdf_onion_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 sdf_onion_rect(vec2 uv, vec2 center, vec2 half_size, float radius, float thickness, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  return vec4(1.0, 1.0, 1.0, sdf_onion_rect_cov(abs(sdf_onion_rect_box(p, half_size, radius)) - thickness, soft));
}
