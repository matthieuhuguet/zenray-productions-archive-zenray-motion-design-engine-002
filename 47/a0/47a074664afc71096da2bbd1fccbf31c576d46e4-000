// 12 October 2026: Two-colour ramp along an angle mixed in linear light (gamma-correct), with a power bias on t. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: angle (degrees (0 = left to right, 90 = top to bottom)), c0 (sRGB 0..1), c1 (sRGB 0..1), bias (exponent on t).
float ramp_linear_light2_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return 0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y));
}
vec3 ramp_linear_light2_to_lin(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}
vec3 ramp_linear_light2_to_srgb(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
vec4 ramp_linear_light2(vec2 uv, float angle, vec3 c0, vec3 c1, float bias) {
  float t = pow(clamp(ramp_linear_light2_axis(uv, angle), 0.0, 1.0), bias);
  return vec4(ramp_linear_light2_to_srgb(mix(ramp_linear_light2_to_lin(c0), ramp_linear_light2_to_lin(c1), t)), 1.0);
}
