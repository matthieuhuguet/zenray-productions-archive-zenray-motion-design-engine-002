float thin_film_iridescence_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 thin_film_iridescence(vec2 uv, vec2 center, vec2 half_size, float radius, float soft, vec3 c_body, float edge_width, float cycles, float phase, float strength, float aspect) {
