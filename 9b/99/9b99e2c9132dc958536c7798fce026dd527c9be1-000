// 12 October 2026: Annulus coverage: absolute circle distance minus a half thickness (onion of a circle). Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), thickness (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_ring_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_ring(vec2 uv, vec2 center, float radius, float thickness, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  return vec4(1.0, 1.0, 1.0, sdf_ring_cov(abs(length(p) - radius) - thickness, soft));
}
