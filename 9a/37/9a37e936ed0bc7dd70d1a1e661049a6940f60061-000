// 12 October 2026: Region inside a parabola opening downwards on screen (y = vertex.y + k x^2), first-order signed distance (value over gradient). Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: vertex (uv), curvature (1 / uv), soft (uv (height units)), aspect (width / height).
float sdf_parabola_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_parabola(vec2 uv, vec2 vertex, float curvature, float soft, float aspect) {
  vec2 p = (uv - vertex) * vec2(aspect, 1.0);
  float d = (curvature * p.x * p.x - p.y) / sqrt(1.0 + 4.0 * curvature * curvature * p.x * p.x);
  return vec4(1.0, 1.0, 1.0, sdf_parabola_cov(d, soft));
}
