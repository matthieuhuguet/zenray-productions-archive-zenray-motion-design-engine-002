import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def _to_lin(c):
    c = np.maximum(c, 0.0)
    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def _to_srgb(c):
    c = np.clip(c, 0.0, 1.0)
    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.power(np.maximum(c, 1e-10), 1.0 / 2.4) - 0.055)


def render(params, u, v):
    q = params
    hdr = _to_lin(_v(q['tint'])) * (2.0 ** (q['ev_min'] + (q['ev_max'] - q['ev_min']) * _axis(u, v, q['angle'])))[..., None]
    e = q['exposure']
    c = hdr * e
    start, desat = 0.8 - 0.04, 0.15
    x = c.min(axis=-1, keepdims=True)
    off = np.where(x < 0.08, x - 6.25 * x * x, 0.04)
    c = c - off
    peak = c.max(axis=-1, keepdims=True)
    d = 1.0 - start
    newp = 1.0 - d * d / (peak + d - start)
    g = 1.0 - 1.0 / (desat * (peak - newp) + 1.0)
    cc = c * (newp / np.maximum(peak, 1e-12))
    mapped = cc + (newp - cc) * g
    c = np.where(peak < start, c, mapped)
    return _to_srgb(c) * 255.0
