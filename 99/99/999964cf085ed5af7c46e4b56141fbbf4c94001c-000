// 12 October 2026: Disc coverage from the exact circle distance, soft smoothstep edge. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), soft (uv (height units)), aspect (width / height).
float sdf_circle_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_circle(vec2 uv, vec2 center, float radius, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  return vec4(1.0, 1.0, 1.0, sdf_circle_cov(length(p) - radius, soft));
}
