// 12 October 2026: Directional rim light inside a rounded rectangle: exp(d / width) times max(dot(sdf gradient, light dir), 0), clipped by the shape. Colour block for add.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), center (uv), half_size (uv (height units)), radius (uv (height units)), width (uv (height units)), light_angle (degrees (0 = right, -90 = up)), intensity (gain), soft (uv (height units)), aspect (width / height).
float rim_light_rect_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
float rim_light_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 rim_light_rect(vec2 uv, vec3 color, vec2 center, vec2 half_size, float radius, float width, float light_angle, float intensity, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float r = min(radius, min(half_size.x, half_size.y));
  vec2 q = abs(p) - half_size + r;
  vec2 g = max(q.x, q.y) > 0.0 ? normalize(max(q, 0.0) + 1e-9) : (q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
  g *= sign(p);
  float d = rim_light_rect_box(p, half_size, radius);
  float a = radians(light_angle);
  float dirf = max(dot(g, vec2(cos(a), sin(a))), 0.0);
  float rim = exp(min(d, 0.0) / width) * dirf * rim_light_rect_cov(d, soft) * intensity;
  return vec4(clamp(color * rim, 0.0, 1.0), 1.0);
}
