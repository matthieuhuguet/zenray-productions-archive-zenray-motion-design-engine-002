import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def _to_lin(c):
    c = np.maximum(c, 0.0)
    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def _to_srgb(c):
    c = np.clip(c, 0.0, 1.0)
    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.power(np.maximum(c, 1e-10), 1.0 / 2.4) - 0.055)


_M1 = np.array([[0.4122214708, 0.5363325363, 0.0514459929], [0.2119034982, 0.6806995451, 0.1073969566],
                [0.0883024619, 0.2817188376, 0.6299787005]])
_M2 = np.array([[0.2104542553, 0.7936177850, -0.0040720468], [1.9779984951, -2.4285922050, 0.4505937099],
                [0.0259040371, 0.7827717662, -0.8086757660]])
_N1 = np.array([[1.0, 0.3963377774, 0.2158037573], [1.0, -0.1055613458, -0.0638541728],
                [1.0, -0.0894841775, -1.2914855480]])
_N2 = np.array([[4.0767416621, -3.3077115913, 0.2309699292], [-1.2684380046, 2.6097574011, -0.3413193965],
                [-0.0041960863, -0.7034186147, 1.7076147010]])


def _lab(c):
    lms = np.maximum(c @ _M1.T, 1e-12) ** (1.0 / 3.0)
    return lms @ _M2.T


def _unlab(c):
    lms = c @ _N1.T
    return (lms ** 3) @ _N2.T


def _okmix(a, b, t):
    t = np.asarray(t, dtype=float)[..., None] if np.ndim(t) else t
    return _to_srgb(_unlab(_lab(_to_lin(_v(a))) + (_lab(_to_lin(_v(b))) - _lab(_to_lin(_v(a)))) * t))


def render(params, u, v):
    q = params
    w = min(max(q['time'], 0.0), 1.0)
    w = w + (w * w * (3.0 - 2.0 * w) - w) * q['ease']
    la = _lab(_to_lin(_v(q['a0']))) + (_lab(_to_lin(_v(q['a1']))) - _lab(_to_lin(_v(q['a0'])))) * w
    lb = _lab(_to_lin(_v(q['b0']))) + (_lab(_to_lin(_v(q['b1']))) - _lab(_to_lin(_v(q['b0'])))) * w
    t = _axis(u, v, q['angle'])[..., None]
    return _to_srgb(_unlab(la + (lb - la) * t)) * 255.0
