def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    a = (np.arctan2(py, px) - np.radians(q['start'])) / 6.28318530718
    turn = a - np.floor(a)
    e = q['progress'] * (1.0 + 2.0 * q['soft']) - q['soft']
    return 1.0 - _ss(e - q['soft'], e + q['soft'], turn)
