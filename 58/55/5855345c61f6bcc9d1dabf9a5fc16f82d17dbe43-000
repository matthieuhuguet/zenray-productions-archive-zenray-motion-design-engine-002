// 12 October 2026: Radial vignette as a multiplier: mix(1, tint, amount * smoothstep(inner, outer, r)). Colour block for the multiply blend.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), inner (uv (height units)), outer (uv (height units)), amount (strength), tint (sRGB 0..1), aspect (width / height).
vec4 vignette_radial(vec2 uv, vec2 center, float inner, float outer, float amount, vec3 tint, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float lo = min(inner, outer), hi = max(inner, outer) + 1e-4;
  float f = amount * smoothstep(lo, hi, length(p));
  return vec4(mix(vec3(1.0), tint, f), 1.0);
}
