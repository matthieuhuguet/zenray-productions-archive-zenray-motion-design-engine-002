# 12 October 2026: numpy twin of block.glsl (same formula, vectorised). Returns HxW coverage in 0..1 (mask block).
import numpy as np


def _smoothstep(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    cx, cy = params["center"]
    bx, by = params["half_size"]
    px = (u - cx) * params["aspect"]
    py = v - cy
    r = min(params["radius"], min(bx, by))
    qx = np.abs(px) - bx + r
    qy = np.abs(py) - by + r
    d = np.hypot(np.maximum(qx, 0.0), np.maximum(qy, 0.0)) + np.minimum(np.maximum(qx, qy), 0.0) - r
    soft = params["soft"]
    return 1.0 - _smoothstep(-soft, soft, d)
