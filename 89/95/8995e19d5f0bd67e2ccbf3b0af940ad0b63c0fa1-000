// 12 October 2026: Voronoi cells filled with a hashed mix of two colours and separated by soft borders (F2 - F1). Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (pcg2d hash implemented from Jarzynski and Olano, Hash Functions for GPU Rendering, JCGT 2020; algorithm, no code copied), same licence as the engine.
// Source: https://jcgt.org/published/0009/03/02/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 noise_voronoi_cells_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
// 12 October 2026: two uniform values in [0, 1) per integer cell, exact 24-bit conversion (identical in numpy).
vec2 noise_voronoi_cells_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = noise_voronoi_cells_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
// 12 October 2026: cellular distances F1, F2 over the 3 x 3 neighbourhood, plus the nearest cell.
vec4 noise_voronoi_cells_worley(vec2 p, float seed, float jitter) {
  vec2 i = floor(p);
  vec2 f = p - i;
  float d1 = 8.0, d2 = 8.0;
  vec2 best = i;
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 g = vec2(float(x), float(y));
      vec2 o = g + 0.5 + jitter * (noise_voronoi_cells_hash2(i + g, seed) - 0.5);
      float d = length(o - f);
      if (d < d1) { d2 = d1; d1 = d; best = i + g; }
      else if (d < d2) { d2 = d; }
    }
  }
  return vec4(d1, d2, best);
}
vec4 noise_voronoi_cells(vec2 uv, float scale, vec2 offset, float seed, float jitter, vec3 c0, vec3 c1, float border, vec3 border_color, float aspect) {
  vec2 p = vec2(uv.x * aspect, uv.y) * scale + offset;
  vec4 w = noise_voronoi_cells_worley(p, seed, jitter);
  vec3 col = mix(c0, c1, noise_voronoi_cells_hash2(w.zw, seed).y);
  float e = smoothstep(0.0, border, w.y - w.x);
  return vec4(mix(border_color, col, e), 1.0);
}
