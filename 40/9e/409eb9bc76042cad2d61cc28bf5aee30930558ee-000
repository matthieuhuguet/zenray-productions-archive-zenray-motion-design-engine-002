// 12 October 2026: Circular arc stroke with round caps from a start angle over a span, exact distance (ring inside the span, end points outside). Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), thickness (uv (height units)), start (degrees (0 = right, 90 = down)), span (degrees), soft (uv (height units)), aspect (width / height).
float sdf_arc_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 sdf_arc(vec2 uv, vec2 center, float radius, float thickness, float start, float span, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float a = degrees(atan(p.y, p.x));
  float t = mod(a - start, 360.0);
  float d;
  if (t <= span) {
    d = abs(length(p) - radius) - thickness;
  } else {
    float s0 = radians(start), s1 = radians(start + span);
    d = min(length(p - radius * vec2(cos(s0), sin(s0))), length(p - radius * vec2(cos(s1), sin(s1)))) - thickness;
  }
  return vec4(1.0, 1.0, 1.0, sdf_arc_cov(d, soft));
}
