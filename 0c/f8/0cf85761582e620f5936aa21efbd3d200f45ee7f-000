// 12 October 2026: rounded rectangle coverage with a soft edge (signed distance field, written from the mathematics).
// uv: pixel centre in [0,1]^2, v from top to bottom. Returns a mask block: vec4(1, 1, 1, coverage).
// Params: center (uv), half_size (half extents, uv units of height), radius (corner radius), soft (half width of
// the smoothstep edge), aspect (canvas width / height, so the shape stays square in pixels).
float sdf_rounded_rect_sd(vec2 p, vec2 b, float r) {
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 sdf_rounded_rect(vec2 uv, vec2 center, vec2 half_size, float radius, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float r = min(radius, min(half_size.x, half_size.y));
  float d = sdf_rounded_rect_sd(p, half_size, r);
  float m = 1.0 - smoothstep(-soft, soft, d);
  return vec4(1.0, 1.0, 1.0, m);
}
