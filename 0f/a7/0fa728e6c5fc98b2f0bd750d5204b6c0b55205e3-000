// 12 October 2026: gradient (Perlin style) noise with unit gradients and quintic fade, range about [-0.71, 0.71].
float noise_ridged_gnoise(vec2 p, float seed) {
  vec2 i = floor(p);
  vec2 f = p - i;
  vec2 w = noise_ridged_quintic(f);
  float a = noise_ridged_gdot(i, seed, f);
  float b = noise_ridged_gdot(i + vec2(1.0, 0.0), seed, f - vec2(1.0, 0.0));
  float c = noise_ridged_gdot(i + vec2(0.0, 1.0), seed, f - vec2(0.0, 1.0));
  float d = noise_ridged_gdot(i + vec2(1.0, 1.0), seed, f - vec2(1.0, 1.0));
